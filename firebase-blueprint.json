{
  "entities": {
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Manually provisioned super administrator marker in /admins/{uid}.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["superadmin"],
          "description": "Administrator role."
        }
      },
      "required": ["role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Employee profile stored at /users/{userId}. No email address is stored.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "office": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roleCategory": {
          "type": "string",
          "enum": ["Faculty", "Academic Administrator", "Support Office"]
        },
        "position": { "type": "string", "minLength": 1, "maxLength": 120 },
        "jobDescription": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "yearsInRole": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "office",
        "roleCategory",
        "position",
        "jobDescription",
        "yearsInRole",
        "createdAt",
        "updatedAt"
      ]
    },
    "CostAudit": {
      "title": "CostAudit",
      "description": "Single TQM Cost of Quality interview audit and generated Quality Cost Sheet.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["in_progress", "completed"] },
        "questionNumber": { "type": "integer" },
        "answerCount": { "type": "integer" },
        "profileSnapshot": { "type": "object" },
        "costSheet": {
          "type": "object",
          "description": "Quality Cost Sheet including statedHours, checks, confirmedByEmployee, and hoursEdited."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "status",
        "questionNumber",
        "answerCount",
        "profileSnapshot",
        "costSheet",
        "createdAt",
        "updatedAt",
        "completedAt"
      ]
    },
    "InteractionMessage": {
      "title": "InteractionMessage",
      "description": "Single interview turn message stored under /users/{userId}/interactions/{interactionId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "auditId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "questionNumber": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "modelUsed": { "type": "string", "maxLength": 100 },
        "clientMessageId": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "userId",
        "auditId",
        "role",
        "content",
        "questionNumber",
        "timestamp",
        "modelUsed",
        "clientMessageId"
      ]
    },
    "QualityBaseline": {
      "title": "QualityBaseline",
      "description": "Admin-uploaded NDKC quality baseline documents stored in settings/qualityBaseline.",
      "type": "object",
      "properties": {
        "documents": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["documents", "updatedAt", "updatedBy"]
    },
    "LedgerReport": {
      "title": "LedgerReport",
      "description": "Consolidated quality cost report generated by Gemini and saved by the super admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "stats": { "type": "object" },
        "modelUsed": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["title", "markdown", "stats", "modelUsed", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Super admin marker document manually created in Firebase Console."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Employee profile document without email."
    },
    "/users/{userId}/costAudits/{auditId}": {
      "schema": { "$ref": "#/entities/CostAudit" },
      "description": "User's cost audit documents."
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": { "$ref": "#/entities/InteractionMessage" },
      "description": "User's interview messages."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/QualityBaseline" },
      "description": "Application-wide settings including settings/qualityBaseline."
    },
    "/ledgerReports/{reportId}": {
      "schema": { "$ref": "#/entities/LedgerReport" },
      "description": "Admin-only consolidated quality cost reports."
    }
  }
}
